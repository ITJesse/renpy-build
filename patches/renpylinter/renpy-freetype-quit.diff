+# RenPyLinter: the number of FTFace / FTFont objects alive, and whether
+# quit() is waiting for the last of them before destroying the library.
+cdef int live_objects = 0
+cdef bint quit_pending = False
+
+
+cdef void _done_library():
+    global library, quit_pending
+
+    quit_pending = False
+
+    if library != NULL:
+        FT_Done_FreeType(library)
+        library = NULL
+
+
+cdef void _object_created():
+    global live_objects
+
+    live_objects += 1
+
+
+cdef void _object_destroyed():
+    global live_objects
+
+    live_objects -= 1
+
+    if live_objects <= 0 and quit_pending:
+        _done_library()
+
+
+def quit():
+    """
+    Destroys the FreeType library that init() created, immediately when no
+    FTFace / FTFont is alive and otherwise from the last of their
+    __dealloc__ methods, so every bitmap, stroker and face is released
+    through FreeType first. Upstream never calls FT_Done_FreeType; this
+    exists for hosts that run several Ren'Py sessions in one process
+    (RenPyLinter), where the module's statics are reset between sessions
+    and the library would otherwise stay allocated once per session.
+    Returns True when the library was destroyed now, False when that is
+    deferred to the last __dealloc__.
+    """
+
+    global quit_pending
+
+    if live_objects > 0:
+        quit_pending = True
+        return False
+
+    _done_library()
+    return True
