+/* RenPyLinter: VideoToolbox decoding ****************************************/
+
+/* Video streams are decoded by VideoToolbox when the device has a hardware
+ * decoder for them and by FFmpeg's software decoders otherwise; the frames
+ * VideoToolbox returns are copied into ordinary frames, so everything after
+ * decoding is unchanged. Each stream's first frame logs which one decoded
+ * it, through the host app's log when the app provides one. */
+
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/pixdesc.h>
+
+#if defined(__APPLE__)
+#include <VideoToolbox/VideoToolbox.h>
+#define RPL_VIDEOTOOLBOX 1
+#endif
+
+static void rpl_log(const char *format, ...) {
+	/* Looked up at run time: the engine links without the host app. */
+	static void (*host_log)(const char *) = NULL;
+	static int looked_up = 0;
+
+	if (!looked_up) {
+		host_log = (void (*)(const char *)) dlsym(RTLD_DEFAULT, "RenPyLinterEngineLog");
+		looked_up = 1;
+	}
+
+	char message[512];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(message, sizeof(message), format, args);
+	va_end(args);
+
+	if (host_log) {
+		host_log(message);
+	} else {
+		fprintf(stderr, "%s\n", message);
+	}
+}
+
+/* The decoder for a stream. AV1: FFmpeg prefers dav1d (software); its own
+ * av1 decoder only drives hardware, so it is chosen when the device has an
+ * AV1 hardware decoder. */
+static const AVCodec *rpl_find_decoder(AVCodecContext *codec_ctx) {
+	const AVCodec *codec = NULL;
+
+#ifdef RPL_VIDEOTOOLBOX
+	if (codec_ctx->codec_id == AV_CODEC_ID_AV1 && VTIsHardwareDecodeSupported(kCMVideoCodecType_AV1)) {
+		codec = avcodec_find_decoder_by_name("av1");
+	}
+#endif
+
+	if (codec == NULL) {
+		codec = avcodec_find_decoder(codec_ctx->codec_id);
+	}
+
+	if (codec == NULL) {
+		rpl_log("RenPyLinter media: no decoder for %s", avcodec_get_name(codec_ctx->codec_id));
+	}
+
+	return codec;
+}
+
+/* VideoToolbox when offered; otherwise (no hardware decoder for the stream:
+ * FFmpeg asks again without it) the first software format. */
+static enum AVPixelFormat rpl_get_format(AVCodecContext *codec_ctx, const enum AVPixelFormat *formats) {
+	const enum AVPixelFormat *p;
+
+	for (p = formats; *p != AV_PIX_FMT_NONE; p++) {
+		if (*p == AV_PIX_FMT_VIDEOTOOLBOX) {
+			return *p;
+		}
+	}
+
+	for (p = formats; *p != AV_PIX_FMT_NONE; p++) {
+		const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(*p);
+		if (desc && !(desc->flags & AV_PIX_FMT_FLAG_HWACCEL)) {
+			return *p;
+		}
+	}
+
+	return AV_PIX_FMT_NONE;
+}
+
+static void rpl_setup_decoder(AVFormatContext *ctx, int index, AVCodecContext *codec_ctx) {
+#ifdef RPL_VIDEOTOOLBOX
+	if (ctx->streams[index]->codecpar->codec_type != AVMEDIA_TYPE_VIDEO) {
+		return;
+	}
+
+	AVBufferRef *device = NULL;
+	if (av_hwdevice_ctx_create(&device, AV_HWDEVICE_TYPE_VIDEOTOOLBOX, NULL, NULL, 0) == 0) {
+		/* Owned by the context from now on. */
+		codec_ctx->hw_device_ctx = device;
+		codec_ctx->get_format = rpl_get_format;
+	}
 #endif
+}
 
