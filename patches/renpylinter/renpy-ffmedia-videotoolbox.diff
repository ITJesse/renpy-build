+/* RenPyLinter: a frame VideoToolbox decoded becomes an ordinary frame in
+ * place. A change of frame format (hardware to software) recreates the
+ * scaler. */
+static int rpl_receive_video_frame(MediaState *ms) {
+	AVFrame *frame = ms->video_decode_frame;
+	int hardware = (frame->format == AV_PIX_FMT_VIDEOTOOLBOX);
+
+	if (hardware) {
+		AVFrame *software = av_frame_alloc();
+		if (software == NULL) {
+			return AVERROR(ENOMEM);
+		}
+
+		int ret = av_hwframe_transfer_data(software, frame, 0);
+		if (ret >= 0) {
+			ret = av_frame_copy_props(software, frame);
+		}
+		if (ret < 0) {
+			rpl_log("RenPyLinter video: could not copy a VideoToolbox frame (%d)", ret);
+			av_frame_free(&software);
+			return ret;
+		}
+
+		av_frame_unref(frame);
+		av_frame_move_ref(frame, software);
+		av_frame_free(&software);
+	}
+
+	if (!ms->rpl_video_logged) {
+		ms->rpl_video_logged = 1;
+		rpl_log("RenPyLinter video: %s %dx%d decoded by %s",
+			avcodec_get_name(ms->video_context->codec_id), frame->width, frame->height,
+			hardware ? "VideoToolbox" : ms->video_context->codec->name);
+	}
+
+	if (frame->format != ms->rpl_video_format) {
+		if (ms->sws) {
+			sws_freeContext(ms->sws);
+			ms->sws = NULL;
+		}
+		ms->rpl_video_format = frame->format;
+	}
+
+	return 0;
+}
