# RenPyLinter patch series for this engine branch.
#
# Format: <patch file> <where it is applied>
#   root          applied with `patch -p1` to the renpy-build checkout by
#                 tools/runtime (renpylinter/tooling) before any task runs
#   task:<module> applied by tasks/<module>.py to the unpacked source
#
# Every file in this directory except this one must be listed.
#
# Ren'Py 7.8.2 runs on Python 2.7, which has no PyMem_SetAllocator; the
# librenpython session zone does not apply (plan 4.1).

# libffi 3.4.5 aarch64 CFI order; Apple clang errors with "invalid CFI
# advance_loc expression". Upstream libffi 8308bed (#857), released in 3.4.7.
libffi-aarch64-cfi.diff task:libffi

# zlib 1.2.11 defines fdopen() as NULL when TARGET_OS_MAC is set, which
# current Apple SDKs do; the block as in zlib 1.3.1.
zlib-1.2.11-apple-fdopen.diff task:zlib

# The host Python's configure aborts on an arm64 Mac build machine
# ("Unexpected output of 'arch' on OSX"). The cross build's configure has
# that check removed by upstream's python2-cross-darwin.diff already.
python-2.7.18-macos-arm64-build.diff task:hostpython2

# pyobjus enum() passed unicode class names to type(), which needs bytes on
# Python 2 (Ren'Py 7.8 uses unicode_literals). Replaces the runtime
# monkeypatch RenPyLinter carried in its 7.8.2 main.py.
pyobjus-enum-text-names.diff task:pyobjus

# makesetup lists an object once per Setup line that names it (_math.o,
# timemodule.o, pwdmodule.o), so libpython2.7.a held duplicate members and
# could not be force-loaded. Archive each object once; objects unchanged.
python-2.7.18-libpython-unique-members.diff task:python2

# The Objective-C runtime's copy functions return memory the caller frees
# (objc/runtime.h); pyobjus never freed class_copyPropertyList's array
# (once per autoclass()). This pyobjus commit reads method_getTypeEncoding,
# so it has no method_copy*Type leak.
# Also frees class_copyMethodList's array when a conversion raises.
pyobjus-free-runtime-copies.diff task:pyobjus
