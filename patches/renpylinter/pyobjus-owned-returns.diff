+cdef bint _returns_owned_reference(bytes name):
+    """
+    Whether the selector hands its caller a +1 reference: Cocoa's alloc,
+    new..., copy..., mutableCopy... and init... families (what ARC calls
+    ns_returns_retained). Everything else returns an autoreleased or
+    borrowed reference that the proxy must retain. (RenPyLinter)
+    """
+    for prefix in (b'alloc', b'new', b'copy', b'mutableCopy', b'init'):
+        if name == prefix:
+            return True
+        if name.startswith(prefix) and not name[len(prefix):len(prefix) + 1].islower():
+            return True
+    return False
+
+
+cdef bint _is_init_selector(bytes name):
+    return name == b'init' or (name.startswith(b'init') and not name[4:5].islower())
+
