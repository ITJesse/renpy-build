             if (SDL_SetDisplayModeForDisplay(SDL_GetDisplayForWindow(window), &fullscreen_mode) == 0) {
-#ifndef ANDROID
+/* UIKit's layout callback reports the actual window bounds, which
+                 * can differ from a cached fullscreen display mode. */
+#if !defined(ANDROID) && !defined(SDL_VIDEO_DRIVER_UIKIT)
                 /* Android may not resize the window to exactly what our fullscreen mode is, especially on
                  * windowed Android environments like the Chromebook or Samsung DeX.  Given this, we shouldn't
                  * use fullscreen_mode.w and fullscreen_mode.h, but rather get our current native size.  As such,
@@ -1439,7 +1441,9 @@
 
