+void
+UIKit_UpdateWindowDisplayOrientation(SDL_Window *window)
+{
+    SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+    if (data.uiwindow != nil) {
+        UIKit_UpdateDisplayOrientation(SDL_GetDisplayForWindow(window),
+            UIKit_GetInterfaceOrientation(data.uiwindow, data.uiwindow.screen));
+    }
+}
