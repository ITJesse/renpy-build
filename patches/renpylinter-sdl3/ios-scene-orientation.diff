+#if !defined(SDL_PLATFORM_TVOS) && !defined(SDL_PLATFORM_VISIONOS)
+/* Adapted from SDL 114aca1727c755104ecfbd3bf4db986e0ff483e2 (#16355).
+ * RenPyLinter: prefer the caller's window, then a foreground scene on the
+ * caller's screen, rather than whichever scene of the app is active. */
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(UIWindow *uiwindow, UIScreen *screen)
+{
+    if (@available(iOS 13.0, *)) {
+        UIWindowScene *scene = uiwindow.windowScene;
+        if (scene == nil) {
+            for (UIScene *candidate in [UIApplication sharedApplication].connectedScenes) {
+                if (![candidate isKindOfClass:[UIWindowScene class]]) {
+                    continue;
+                }
+                UIWindowScene *windowScene = (UIWindowScene *)candidate;
+                if (windowScene.screen != screen) {
+                    continue;
+                }
+                if (windowScene.activationState == UISceneActivationStateForegroundActive) {
+                    scene = windowScene;
+                    break;
+                }
+                if (windowScene.activationState == UISceneActivationStateForegroundInactive) {
+                    scene = windowScene;
+                }
+            }
+        }
+        if (scene == nil) {
+            return UIInterfaceOrientationUnknown;
+        }
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 260000
+        if (@available(iOS 26.0, *)) {
+            return scene.effectiveGeometry.interfaceOrientation;
+        }
+#endif
+        // [iOS 13 Compat] Scene orientation predates effectiveGeometry.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+        return scene.interfaceOrientation;
+#pragma clang diagnostic pop
+    }
+    // [iOS 12 Compat] Legacy non-scene applications only.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return [UIApplication sharedApplication].statusBarOrientation;
+#pragma clang diagnostic pop
+}
+#endif // !SDL_PLATFORM_TVOS && !SDL_PLATFORM_VISIONOS
