+/* Adapted from SDL #16355: scene geometry changes replace the status bar
+ * orientation notification. RenPyLinter reads effectiveGeometry from iOS 26
+ * on (see UIKit_GetInterfaceOrientation), so it listens from iOS 26 on. */
+- (void)windowScene:(UIWindowScene *)windowScene didUpdateEffectiveGeometry:(UIWindowSceneGeometry *)previousEffectiveGeometry API_AVAILABLE(ios(26.0))
