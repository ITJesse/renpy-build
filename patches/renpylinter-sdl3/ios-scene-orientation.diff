+/* RenPyLinter: scene-based hosts do not receive UIApplication's old status
+ * bar orientation notification. Keep the window's display modes in sync with
+ * the window's own scene before its resize event is delivered. */
+void UIKit_UpdateWindowDisplayOrientation(SDL_Window *window)
+{
+    SDL_UIKitWindowData *data = (__bridge SDL_UIKitWindowData *)window->internal;
+    if (data != nil && data.uiwindow != nil) {
+        UIKit_UpdateDisplayOrientation(SDL_GetVideoDisplayForWindow(window),
+                                       UIKit_GetInterfaceOrientation(data.uiwindow, data.uiwindow.screen));
+    }
+}
+
+void SDL_OnApplicationDidChangeStatusBarOrientation(void)
+{
+    UIKit_UpdateDisplayOrientation(SDL_GetVideoDisplay(SDL_GetPrimaryDisplay()),
+                                   UIKit_GetInterfaceOrientation(nil, [UIScreen mainScreen]));
+}
 #endif // !SDL_PLATFORM_TVOS
 
 #endif // SDL_VIDEO_DRIVER_UIKIT
